    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
